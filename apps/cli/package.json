{
  "name": "@telar/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/main.ts --target=node --format=esm --external node-pty --external @anthropic-ai/claude-agent-sdk --outfile dist/telar.mjs",
    "test": "bun test --timeout 20000",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.270",
    "@telar/engine": "workspace:*",
    "@telar/engine-client": "workspace:*",
    "node-pty": "1.2.0-beta.15",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "@types/node": "^26.1.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^6.0.3"
  }
}
